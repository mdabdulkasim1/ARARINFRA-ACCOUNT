# Copy this file to .env and change the values before going live.
PORT=3000

# IMPORTANT: change this to a long random string. It signs the login sessions.
JWT_SECRET=change-this-to-a-long-random-secret-string

# How long a login stays valid
SESSION_HOURS=12

# Where the database file lives
DB_FILE=./data/arar-accounts.db

# Group defaults
GROUP_NAME=ARAR INFRA GROUP
DEFAULT_CURRENCY=AED
DEFAULT_PAYMENT_TERMS_DAYS=90
